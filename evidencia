<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Evidence Library · FPAIR</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;700&family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="assets/encyclopedia.css"></head><body><header><div class="wrap hdr"><a class="brand" href="app.html#fpair/home"><img src="logo-fpair-header.png" alt="FPAIR"><span><b>FPAIR</b><small>Educación y entrenamiento respiratorio</small></span></a><nav class="nav"><a href="app.html#fpair/examenes/adult">Exámenes</a><a href="preparacion_info.html">Preparación</a><a href="tecnicas_guiadas.html">Técnica guiada</a><a href="interpretacion_ia.html">Interpretación</a><a href="examenes-seguros.html">Confianza clínica</a></nav><button class="theme" data-theme-toggle>◐</button></div></header><section class="hero"><div class="wrap"><div class="hero-card hero-copy"><span class="eyebrow">FPAIR / EVIDENCE LIBRARY</span><h1>Los papers detrás de la biblioteca.</h1><p class="lead">285 fuentes únicas indexadas a partir de los corpus aportados y referencias PubMed seleccionadas.</p></div></div></section><main class="wrap" style="padding-bottom:70px"><section class="section"><div class="e-controls"><input id="allq" placeholder="Buscar título, DOI, tema…"><select id="allt"><option value="">Todos los exámenes</option><option value="espirometria">Espirometría</option><option value="dlco">DLCO</option><option value="pletismografia">Pletismografía</option><option value="ios">IOS / Oscilometría</option><option value="feno">FeNO</option><option value="pimpem">PIM / PEM</option><option value="metacolina">Provocación con metacolina</option><option value="shunt">Shunt</option><option value="caminata">Caminata de 6 minutos</option><option value="gasometria">Gasometría arterial</option><option value="cpet">CPET</option></select></div><div class="evidence-grid" id="allg"></div></section></main><footer class="footer"><div class="wrap">FPAIR · Evidence Library.</div></footer><script src="assets/evidence-data.js"></script><script src="assets/encyclopedia.js"></script><script>
(function(){const q=document.getElementById('allq'),t=document.getElementById('allt'),g=document.getElementById('allg');function esc(s){return String(s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}function draw(){let a=FPAIR_EVIDENCE.filter(x=>(!t.value||x.topic===t.value)&&(!q.value||JSON.stringify(x).toLowerCase().includes(q.value.toLowerCase())));g.innerHTML=a.slice(0,200).map(x=>'<article class="e-card"><div class="meta">'+esc(x.topic)+' · '+esc(x.year)+'</div><h4>'+esc(x.title)+'</h4>'+(x.summary?'<p>'+esc(x.summary)+'</p>':'')+(x.url?'<a target="_blank" href="'+x.url+'">Fuente / DOI ↗</a>':'')+'</article>').join('');}q.oninput=draw;t.onchange=draw;draw();})();
</script></body></html>
